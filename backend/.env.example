NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Transaction Pooler (Port 6543) for all runtime Prisma queries.
# Add ?pgbouncer=true&connection_limit=5 in production on Supabase.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_nahda"

# Direct connection (Port 5432) — for Prisma migrations ONLY.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── Auth & JWT ───────────────────────────────────────────────────────────────
# Short-lived access token (kept in memory by the frontend, never persisted).
JWT_SECRET="replace-with-your-secret"
JWT_ACCESS_EXPIRY="15m"

# Long-lived refresh token (stored as httpOnly cookie, hashed in DB).
# MUST be different from JWT_SECRET.
JWT_REFRESH_SECRET="replace-with-a-different-secret"
JWT_REFRESH_EXPIRY="7d"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ─── Role assignment ──────────────────────────────────────────────────────────
# Comma-separated Google emails that are automatically granted the ADMIN role
ADMIN_EMAILS="admin@alnahda.com"

# Comma-separated Google emails that should sign in directly as TEACHER
TEACHER_EMAILS="teacher@alnahda.com"

# ─── Email delivery ───────────────────────────────────────────────────────────
# Resend.com API key for student registrations and teacher applications
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
ADMIN_EMAIL="admin@alnahda.com"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (leave empty to reflect origin in dev)
CORS_ORIGINS="http://localhost:3000"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Set on Render to enable error tracking. Leave empty to skip.
SENTRY_DSN=""
