NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_nahda"
# Set this to the direct, non-pooler PostgreSQL URL used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-your-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Comma-separated Google emails that are automatically granted the ADMIN role
ADMIN_EMAILS="admin@alnahda.com"

# Comma-separated list of allowed frontend origins (leave empty to reflect origin)
CORS_ORIGINS="http://localhost:3001"

# Optional — error tracking for production. Set this config var on Render to
# enable Sentry error reporting (https://sentry.io). Leave empty to skip.
SENTRY_DSN=""
