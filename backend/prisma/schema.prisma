generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum Course {
  LEARN_QURAN
  LEARN_ARABIC
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum TestStatus {
  PASSED
  DEMOTED_RECOMMENDED
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudentEnrollmentStatus {
  PENDING
  IN_PROGRESS
  ASSESSMENT_REQUIRED
  ASSESSMENT_COMPLETED
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

/// Fee-bidding lifecycle: NONE = no proposal; PROPOSED = student offered;
/// AGREED = admin confirmed agreedFee; REJECTED = admin declined.
enum FeeStatus {
  NONE
  PROPOSED
  AGREED
  REJECTED
}

// ─────────────────────────── Core Identity Models ───────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String   @unique
  role      UserRole
  createdAt DateTime @default(now())

  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  notifications      Notification[]      @relation("NotificationRecipient")
  sentNotifications  Notification[]      @relation("NotificationSender")
  // Assessment module relations
  studentEnrollments StudentEnrollment[] @relation("StudentEnrollments")
  attempts           Attempt[]           @relation("AttemptStudents")
}

model StudentProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  fullName          String
  profilePictureUrl String?
  whatsappNumber    String?
  bio               String?

  user            User             @relation(fields: [userId], references: [id])
  enrollments     Enrollment[]
  evaluationTests EvaluationTest[]
}

model TeacherProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  fullName          String
  profilePictureUrl String?
  bio               String?
  qualifications    String[]
  experienceYears   Int
  subjectsTaught    String[]
  phoneNumber       String?
  cvUrl             String?
  teacherStatus     TeacherStatus @default(PENDING)

  user        User         @relation(fields: [userId], references: [id])
  enrollments Enrollment[]
}

// ─────────────────────────── Evaluation (original) ───────────────────────────

model EvaluationQuestion {
  id            String @id @default(uuid())
  course        Course
  level         Level
  question      String
  options       Json
  correctAnswer String
}

model EvaluationTest {
  id            String     @id @default(uuid())
  studentId     String
  claimedLevel  Level
  assignedLevel Level
  score         Float
  status        TestStatus
  startedAt     DateTime   @default(now())
  completedAt   DateTime?

  student StudentProfile     @relation(fields: [studentId], references: [id])
  answers EvaluationAnswer[]
}

model EvaluationAnswer {
  id         String  @id @default(uuid())
  testId     String
  questionId String
  answer     String
  isCorrect  Boolean
  points     Int

  test EvaluationTest @relation(fields: [testId], references: [id])
}

// ─────────────────────────── Enrollment (original) ───────────────────────────

model Enrollment {
  id                String           @id @default(uuid())
  studentId         String
  teacherId         String
  courseName        Course
  confirmedLevel    Level
  preferredTimeSlot String
  status            EnrollmentStatus @default(PENDING)
  proposedFee       Int?
  agreedFee         Int?
  feeStatus         FeeStatus        @default(NONE)
  createdAt         DateTime         @default(now())

  student    StudentProfile @relation(fields: [studentId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
  attendance Attendance[]
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  date         DateTime
  status       AttendanceStatus

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, date])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  senderId    String?
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id])
}

// ─────────────────────────── Assessment Module (new) ───────────────────────────

/// A standalone course entity for the assessment/enrollment module.
/// Separate from the Course enum to allow rich metadata and status management.
model CourseItem {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  status      CourseStatus @default(DRAFT)
  standardFee Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  levels             LevelContent[]      @relation("CourseLevels")
  assessments        Assessment[]        @relation("AssessmentCourses")
  studentEnrollments StudentEnrollment[] @relation("Enrollments")
}

/// A level within a CourseItem (e.g. Beginner, Intermediate, Advanced).
model LevelContent {
  id          String   @id @default(uuid())
  courseId    String
  name        String
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course             CourseItem          @relation("CourseLevels", fields: [courseId], references: [id], onDelete: Cascade)
  assessments        Assessment[]        @relation("AssessmentLevels")
  studentEnrollments StudentEnrollment[] @relation("SelectedLevels")

  @@unique([courseId, sortOrder])
  @@index([courseId])
}

/// The question bank — questions reusable across assessments.
model Question {
  id              String       @id @default(uuid())
  text            String
  type            QuestionType @default(MULTIPLE_CHOICE)
  difficulty      Difficulty   @default(MEDIUM)
  course          Course
  level           Level
  /// Array of { id: string, text: string } objects
  options         Json
  correctOptionId String
  points          Int          @default(1)
  explanation     String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assessmentQuestions AssessmentQuestion[] @relation("AssessmentQuestionQuestions")
  attemptQuestions    AttemptQuestion[]    @relation("AttemptQuestionQuestions")
  attemptAnswers      AttemptAnswer[]      @relation("AttemptAnswerQuestions")
}

model Assessment {
  id                    String           @id @default(uuid())
  courseId              String
  levelId               String?
  title                 String
  description           String?
  durationMinutes       Int
  passPercentage        Int              @default(60)
  attemptsAllowed       Int              @default(1)
  questionsPerAttempt   Int              @default(10)
  questionSelectionMode String           @default("manual")
  shuffleQuestions      Boolean          @default(false)
  shuffleOptions        Boolean          @default(false)
  showResultAfterSubmit Boolean          @default(true)
  status                AssessmentStatus @default(DRAFT)
  createdBy             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  course      CourseItem           @relation("AssessmentCourses", fields: [courseId], references: [id], onDelete: Cascade)
  level       LevelContent?        @relation("AssessmentLevels", fields: [levelId], references: [id])
  questions   AssessmentQuestion[] @relation("AssessmentQuestions")
  attempts    Attempt[]            @relation("AttemptAssessments")
  enrollments StudentEnrollment[]  @relation("EnrollmentAssessments")

  @@index([courseId])
  @@index([levelId])
  @@index([status])
}

/// Junction table: which questions belong to an assessment and in what order.
model AssessmentQuestion {
  id             String   @id @default(uuid())
  assessmentId   String
  questionId     String
  sortOrder      Int
  pointsOverride Int?
  createdAt      DateTime @default(now())

  assessment Assessment @relation("AssessmentQuestions", fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation("AssessmentQuestionQuestions", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, sortOrder])
  @@index([assessmentId])
}

/// A student's application/enrollment into a CourseItem.
model StudentEnrollment {
  id                   String                  @id @default(uuid())
  studentId            String
  courseId             String
  selectedLevelId      String?
  assignedAssessmentId String?
  status               StudentEnrollmentStatus @default(PENDING)
  applicationData      String?
  proposedFee          Int?
  agreedFee            Int?
  feeStatus            FeeStatus               @default(NONE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  student            User          @relation("StudentEnrollments", fields: [studentId], references: [id])
  course             CourseItem    @relation("Enrollments", fields: [courseId], references: [id], onDelete: Cascade)
  selectedLevel      LevelContent? @relation("SelectedLevels", fields: [selectedLevelId], references: [id])
  assignedAssessment Assessment?   @relation("EnrollmentAssessments", fields: [assignedAssessmentId], references: [id], onDelete: SetNull)
  attempts           Attempt[]     @relation("EnrollmentAttempts")

  @@index([studentId])
  @@index([courseId])
  @@index([assignedAssessmentId])
  @@index([status])
}

/// A single exam session taken by a student for a given assessment.
model Attempt {
  id               String        @id @default(uuid())
  studentId        String
  assessmentId     String
  enrollmentId     String?
  status           AttemptStatus @default(IN_PROGRESS)
  score            Int?
  percentage       Float?
  passed           Boolean?
  timeSpentSeconds Int?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student    User               @relation("AttemptStudents", fields: [studentId], references: [id])
  assessment Assessment         @relation("AttemptAssessments", fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment? @relation("EnrollmentAttempts", fields: [enrollmentId], references: [id])
  questions  AttemptQuestion[]  @relation("AttemptQuestions")
  answers    AttemptAnswer[]    @relation("AttemptAnswers")

  @@index([studentId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([status])
}

/// Snapshot of which questions were served to a student in a specific attempt.
model AttemptQuestion {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  sortOrder  Int
  createdAt  DateTime @default(now())

  attempt  Attempt  @relation("AttemptQuestions", fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation("AttemptQuestionQuestions", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sortOrder])
  @@index([attemptId])
}

/// A student's answer to one question within an attempt.
model AttemptAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean? @default(false)
  pointsEarned     Int?     @default(0)
  answeredAt       DateTime @default(now())

  attempt  Attempt  @relation("AttemptAnswers", fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation("AttemptAnswerQuestions", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}
