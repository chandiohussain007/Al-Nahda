# Base URL of the deployed Al Nahda API (no trailing slash).
NEXT_PUBLIC_API_URL=https://al-nahda-backend.onrender.com

# Google OAuth client id. Must be the SAME client as GOOGLE_CLIENT_ID on the
# backend, otherwise token verification fails with a 401 audience mismatch.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
